# 数据库（生产 PG；本地可改 sqlite）
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/growth_agent
# DATABASE_URL=sqlite+aiosqlite:///./growth_agent.db

# 推理协议 sentinel（与推理框架工程师约定）
CONCEPT_SENTINEL=≡≡CONCEPT_BLOCK≡≡
INFERENCE_TIMEOUT_S=60
FIRST_TOKEN_TIMEOUT_S=5
JSON_PARSE_TIMEOUT_S=15

# 膨胀控制
MAX_EXPLORE_DEPTH=6
MAX_CONCEPTS_PER_SESSION=200

# 补标注 worker
BACKFILL_MAX_RETRY=3

# 阈值（数据产品经理提供，热加载）
THRESHOLDS_PATH=app/thresholds.local.json
